.DS_Store
**/.DS_Store
cloudemploye data/

# Heavy design + capture artefacts (~1.4GB combined). These are local working
# references, not repo content: Figma binaries, Webflow single-file exports with
# every asset inlined, PDF prints and screenshot runs. Git stores them forever
# even after deletion, and GitHub hard-rejects any single file over 100MB.
# Keep them backed up outside the repo.
CE-Figma-redesign/
*.fig
*.zip
docs/raw-html/
docs/raw-html-pdf/
docs/live-captures-jul2026/
docs/re-design/screenshots/
docs/blog_topic_hubs.pdf

docs/images/

# Third-party lead exports. Company and contact data pulled from TheirStack -
# keep it out of git for the same reason audit-output is ignored.
data/theirstack/

# Scratch verification scripts. One-shot Playwright probes written to answer a
# single question (a Marker ticket, a page audit) and never re-run. The durable
# gates live in scripts/ and are wired to npm run.
__verify*.js
.audit.tmp.js
agents/*/qa-*.mts

# Agent tooling - local editor state and nested git checkouts, never repo content
.claude/
artifacts/
.vercel
