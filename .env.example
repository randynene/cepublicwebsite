# Mygratr — root .env template.
# Copy to .env (gitignored) and fill in real values.
# The Next.js app reads its own variables from site/.env.local — not this file.

# ---------- Supabase ----------
SUPABASE_URL=https://xpzrhzfzppypxbipvyzm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres direct URL for DDL via scripts (currently broken — see Tech Debt #12).
SUPABASE_DB_URL=

# ---------- Webflow (source CMS for CE) ----------
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=673326831abed6267051fa11

# ---------- Firecrawl / Anthropic / HubSpot / Ahrefs ----------
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
AHREFS_API_KEY=

# ---------- Sanity ----------
SANITY_PROJECT_ID=lzbhll1u
SANITY_DATASET=production

# Legacy general-purpose Sanity token. Kept for SCHEMA-lane seed scripts
# (scripts/schema/seed-singletons.ts, scripts/schema/smoke-test-seed.ts).
# Migration scripts MUST NOT read this — they use SANITY_MIGRATION_WRITE_TOKEN.
SANITY_API_TOKEN=

# CONTENT-1D §0.1 — least-privilege migration token. Required by every
# migration script (loaded via src/lib/content/sanity-write-client.ts).
#
# Required permissions (set in Sanity manage → API tokens):
#   - Single dataset: production
#   - Role: minimum permitting document patch + document delete + asset upload
#   - DO NOT grant project-admin or all-datasets scope
#
# Rotate after CONTENT-1D completes (Exit Criterion #10 —
# MUST resolve before MYGRATR-LAUNCH).
SANITY_MIGRATION_WRITE_TOKEN=

# CRITICAL: SANITY_API_READ_TOKEN must NOT be set in this file.
# The site read token belongs in site/.env.local only. Its presence in the
# migration-script process triggers a runtime assertion in
# src/lib/content/sanity-write-client.ts (F14 — path-alias collision guard).
# SANITY_API_READ_TOKEN=  ← intentionally absent
